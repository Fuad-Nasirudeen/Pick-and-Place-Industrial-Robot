 qnear=Above_PickPos.q), a=0.25, v=0.5)\n  $ 7 \"\"\n  while (get_standard_digital_in(0) == False):\n    sync()\n  end\n  $ 8 \"\"\n  set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n  optimovel(convert_pose(PickPos.p, PickPos.frame, \"base\"), a=0.09, v=0.3)\n  $ 9 \"\"\n  set_tool_digital_out(0,False)\n  set_tool_digital_out(1,True)\n  $ 10 \"\"\n  set_target_payload(1.1, [0, 0, 0])\n  $ 11 \"2.00 s\"\n  sleep(2.0)\n  $ 12 \"\"\n  optimovel(convert_pose(Above_PickPos.p, Above_PickPos.frame, \"base\"), a=0.25, v=0.5)\nend\n$ 13 \"\"\ndef Place():\n  $ 14 \"\"\n  set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n  optimovej(get_inverse_kin(convert_pose(Above_PlacePos.p, Above_PlacePos.frame, \"base\"), qnear=Above_PlacePos.q), a=0.25, v=0.5)\n  $ 15 \"\"\n  while (get_standard_digital_in(1) == False):\n    sync()\n  end\n  $ 16 \"Counter > 1 and Counter < 4\"\n  if (Counter > 1 and Counter < 4):\n    $ 17 \"\"\n    set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n    optimovej(get_inverse_kin(convert_pose(PlacePos2.p, PlacePos2.frame, \"base\"), qnear=PlacePos2.q), a=0.09, v=0.3)\n  $ 18 \"Counter > 3\"\n  elif (Counter > 3):\n    $ 19 \"\"\n    optimovel(convert_pose(PlacePos3.p, PlacePos3.frame, \"base\"), a=0.09, v=0.3)\n  $ 20 \"\"\n  else:\n    $ 21 \"\"\n    set_tcp(p[0, 0, 0.115, 0, 0, 0], \"TCP_SimpleGripper_1\")\n    optimovel(convert_pose(PlacePos.p, PlacePos.frame, \"base\"), a=0.09, v=0.3)\n  end\n  $ 22 \"\"\n  set_tool_digital_out(0,True)\n  set_tool_digital_out(1,False)\n  $ 23 \"\"\n  set_target_payload(0.122366, [-8.271806125530239e-21, 4.776114657058022e-19, 0.002001356682800776], [0.00008452945323247324, 0.00008048281915663539, 0.00006969117649936129, -1.9386991750998697e-23, 2.212702009854895e-22, -1.6766150729520216e-21])\n  $ 24 \"1.00 s\"\n  sleep(1)\n  $ 25 \"\"\n  optimovel(convert_pose(Above_PlacePos.p, Above_PlacePos.frame, \"base\"), a=0.25, v=0.5)\n  $ 26 \"block_dropped:True\"\n  block_dropped = True\nend\n$